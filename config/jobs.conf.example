# Copy to config/jobs.conf and adjust for the target repository.

REPO_NAME="example-repo"
REPO_PATH="/srv/repos/example-repo"
BASE_BRANCH="main"
NIGHTLY_BRANCH_PREFIX="nightly/codex"
TASK_FILE="${AI_NIGHTLY_ROOT}/tasks/codex_goal_prompt.md"

MAX_RUNTIME="5h"
LOG_DIR="${AI_NIGHTLY_ROOT}/logs"
REPORT_DIR="${AI_NIGHTLY_ROOT}/reports"
LOCK_DIR="${AI_NIGHTLY_ROOT}/run/lock"

# Optional verification commands run from REPO_PATH after Codex finishes.
TEST_COMMAND=""
LINT_COMMAND=""
BUILD_COMMAND=""

# Codex execution defaults. Keep approval policy as never for unattended runs.
CODEX_BIN="codex"
CODEX_SANDBOX="workspace-write"
CODEX_APPROVAL_POLICY="never"
CODEX_MODEL=""
CODEX_PROFILE=""
CODEX_EXEC_ARGS=""
CODEX_AUTONOMY_LEVEL="pr-ready"

# PR output defaults.
# off: no PR draft, draft-file: write reports/YYYYMMDD/*-pr.md, gh-draft: push and open a GitHub draft PR.
PR_MODE="draft-file"
PR_REMOTE="origin"

# Model auto-failover: automatically switch between models based on 5h usage tracking.
# Set MODEL_AUTO_FAILOVER=true to enable. CODEX_MODEL must be empty to allow auto-selection.
# Primary model is used first; when it reaches <=MODEL_SWITCH_THRESHOLD% of MODEL_SESSION_LIMIT,
# or hits weekly quota, the fallback model is used instead. Resets every Monday.
MODEL_AUTO_FAILOVER="false"
MODEL_PRIMARY="gpt-5.3-codex-spark"
MODEL_FALLBACK="gpt-5.5"
MODEL_SESSION_LIMIT="18000"
MODEL_SWITCH_THRESHOLD="10"
